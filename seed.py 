import json
from pathlib import Path

from database import SessionLocal
from models import Categoria, Alimento


def importar_taco():
    db = SessionLocal()

    try:
        # Se já existem alimentos, não importa novamente
        if db.query(Alimento).count() > 0:
            print("TACO já foi importada.")
            return

        caminho_taco = Path(__file__).parent / "taco.json"

        print(f"Carregando TACO: {caminho_taco}")

        with open(caminho_taco, "r", encoding="utf-8") as f:
            dados = json.load(f)

        categorias = {}

        for item in dados:
            nome_categoria = item["category"]

            if nome_categoria not in categorias:
                categoria = (
                    db.query(Categoria)
                    .filter(Categoria.nome == nome_categoria)
                    .first()
                )

                if categoria is None:
                    categoria = Categoria(nome=nome_categoria)
                    db.add(categoria)
                    db.commit()
                    db.refresh(categoria)

                categorias[nome_categoria] = categoria

            alimento = Alimento(
                nome=item["description"],
                calorias=float(item.get("energy_kcal") or 0),
                proteinas=float(item.get("protein_g") or 0),
                carboidratos=float(item.get("carbohydrate_g") or 0),
                gorduras=float(item.get("lipid_g") or 0),
                fibras=float(item.get("fiber_g") or 0),
                acucares=0,
                sodio=float(item.get("sodium_mg") or 0),
                potassio=float(item.get("potassium_mg") or 0),
                calcio=float(item.get("calcium_mg") or 0),
                ferro=float(item.get("iron_mg") or 0),
                magnesio=float(item.get("magnesium_mg") or 0),
                fosforo=float(item.get("phosphorus_mg") or 0),
                vitamina_a=0,
                vitamina_c=float(item.get("vitaminC_mg") or 0),
                porcao="100 g",
                categoria_id=categorias[nome_categoria].id
            )

            db.add(alimento)

        db.commit()

        total = db.query(Alimento).count()
        print(f"{total} alimentos importados com sucesso!")

    except Exception as e:
        db.rollback()
        print(f"ERRO AO IMPORTAR TACO: {e}")
        raise

    finally:
        db.close()

